{
  "name": "genius-pay-sdk",
  "version": "1.1.0",
  "description": "Official SDK for ethpar services. For more details visit https://www.ethpar.com/#join-network",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "require": "./lib/index.js",
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./crypto": {
      "require": "./lib/crypto.js",
      "import": "./lib/crypto.js",
      "types": "./lib/crypto.d.ts"
    },
    "./dora": {
      "require": "./lib/dora/index.js",
      "import": "./lib/dora/index.js",
      "types": "./lib/dora/index.d.ts"
    },
    "./device-info": {
      "require": "./lib/device-info.js",
      "import": "./lib/device-info.js",
      "types": "./lib/device-info.d.ts"
    },
    "./atm": {
      "require": "./lib/atm/index.js",
      "import": "./lib/atm/index.js",
      "types": "./lib/atm/index.d.ts"
    },
    "./pos": {
      "require": "./lib/pos/index.js",
      "import": "./lib/pos/index.js",
      "types": "./lib/pos/index.d.ts"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf ./lib/",
    "release": "npm run build && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethpar/genius-pay-sdk-js.git"
  },
  "keywords": [
    "ethpar",
    "llama-pay"
  ],
  "author": "",
  "license": "Apache-2.0",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "ethers": "^6.17.0",
    "jose": "^6.2.4"
  },
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc"
}